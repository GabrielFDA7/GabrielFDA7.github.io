---
// O conteúdo da home. Os links de foco usam esta mesma composição, mudando só o que o foco define.
import type { Foco } from '../config/focos';
import { idiomaDaPagina, rota } from '../i18n';
import { experienciaNoIdioma, projetosNoIdioma } from '../lib/conteudo';
import { comPrincipal, selecionarParaFoco } from '../lib/projetos';
import Contato from './Contato.astro';
import ExperienciaResumo from './ExperienciaResumo.astro';
import Hero from './Hero.astro';
import LinhaProjeto from './LinhaProjeto.astro';
import MetodoIA from './MetodoIA.astro';
import ProjetoPrincipal from './ProjetoPrincipal.astro';
import TituloSecao from './TituloSecao.astro';

interface Props {
  foco?: Foco | undefined;
}

const { foco } = Astro.props;
const { idioma, t } = idiomaDaPagina(Astro.url);
const versao = foco?.[idioma];
const todos = await projetosNoIdioma(idioma);
const selecao = foco
  ? comPrincipal(selecionarParaFoco(todos, foco.tags), foco.principal)
  : todos.filter((projeto) => projeto.data.featured);
const [principal, ...outros] = selecao;
const experiencia = (await experienciaNoIdioma(idioma)).filter((item) => item.data.naHome);
---

<Hero chamada={versao?.chamada} curriculo={versao?.curriculo} />
{foco?.iaPrimeiro && <MetodoIA />}
{principal && <ProjetoPrincipal projeto={principal} />}
{outros.length > 0 && (
  <section class="pagina mt-secao" aria-labelledby="outros-projetos">
    <TituloSecao id="outros-projetos" rotulo={t.inicio.emDestaque} titulo={t.inicio.outrosProjetos} />
    <ul class="mt-8">
      {outros.map((projeto, indice) => (
        <li><LinhaProjeto projeto={projeto} numero={indice + 2} /></li>
      ))}
    </ul>
    <p class="mt-2"><a class="inline-flex min-h-11 items-center font-medium" href={rota(idioma, 'projetos')}>{t.inicio.verTodos}</a></p>
  </section>
)}
{!foco?.iaPrimeiro && <MetodoIA />}
<ExperienciaResumo itens={experiencia} />
<Contato />
