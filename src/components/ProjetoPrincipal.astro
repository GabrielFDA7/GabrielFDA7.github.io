---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icone from './Icone.astro';
import Metricas from './Metricas.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const { data } = projeto;
---

<section class="pagina mt-secao" aria-labelledby="projeto-principal">
  <p class="rotulo">Projeto principal</p>
  <div class="cartao mt-4 grid overflow-hidden md:grid-cols-[1fr_auto]">
    <div class="flex flex-col gap-6 p-6 sm:p-10">
      <div>
        <h2 id="projeto-principal" class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{data.title}</h2>
        <p class="mt-3 max-w-xl text-texto-suave">{data.summary}</p>
      </div>
      <Metricas itens={data.metrics} grande />
      <div class="mt-auto flex flex-wrap gap-3">
        <a class="btn btn-cromo" href={`/projetos/${data.slug}`}>Ver estudo de caso</a>
        {data.links.demo && (
          <a class="btn btn-contorno" href={data.links.demo}>
            Abrir demo
            <Icone nome="externo" class="size-4" />
          </a>
        )}
        {data.links.repo && (
          <a class="btn btn-contorno" href={data.links.repo}>
            <Icone nome="github" />
            Código
          </a>
        )}
      </div>
    </div>
    {data.cover && (
      <div class="tela border-t border-linha md:border-t-0 md:border-l">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? ''}
          widths={[320, 480, 600]}
          sizes="(min-width: 48rem) 20rem, 100vw"
          class="size-full object-cover object-top"
        />
      </div>
    )}
  </div>
</section>

<style>
  /* A captura é bem alta: o enquadramento fixo mostra só o topo, com o mapa. */
  .tela {
    height: 20rem;
  }

  @media (min-width: 48rem) {
    .tela {
      width: 20rem;
      height: 26rem;
    }
  }
</style>
