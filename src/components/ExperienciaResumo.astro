---
import type { CollectionEntry } from 'astro:content';
import TituloSecao from './TituloSecao.astro';

interface Props {
  itens: readonly CollectionEntry<'experiencia'>[];
}

const { itens } = Astro.props;
---

<section class="pagina mt-secao" aria-labelledby="experiencia">
  <TituloSecao id="experiencia" rotulo="Trajetória" titulo="Experiência" />
  <ol class="tubo mt-8 max-w-3xl lg:mt-10">
    {itens.map(({ data }) => (
      <li class="parada">
        <p class="rotulo">{data.period}</p>
        <h3 class="mt-2 text-2xl font-bold tracking-tight">{data.cargo}</h3>
        <p class="text-sm text-texto-suave">{data.empresa}{data.contexto ? ` · ${data.contexto}` : ''}</p>
        <p class="mt-3 text-texto-suave">{data.resumo}</p>
      </li>
    ))}
  </ol>
  <p class="mt-4"><a class="inline-flex min-h-11 items-center font-medium" href="/sobre/">Trajetória completa</a></p>
</section>
