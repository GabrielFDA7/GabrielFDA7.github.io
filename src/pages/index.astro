---
import { getCollection } from 'astro:content';
import Contato from '../components/Contato.astro';
import ExperienciaResumo from '../components/ExperienciaResumo.astro';
import Hero from '../components/Hero.astro';
import MetodoIA from '../components/MetodoIA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjetoPrincipal from '../components/ProjetoPrincipal.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicados } from '../lib/projetos';

const destaques = publicados(await getCollection('projetos')).filter((projeto) => projeto.data.featured);
const [principal, ...outros] = destaques;
const experiencia = (await getCollection('experiencia')).toSorted((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <Hero />
  {principal && <ProjetoPrincipal projeto={principal} />}
  {outros.length > 0 && (
    <section class="pagina mt-secao" aria-labelledby="outros-projetos">
      <p class="rotulo">Em destaque</p>
      <h2 id="outros-projetos" class="mt-3 text-3xl font-bold tracking-tight">Outros projetos</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {outros.map((projeto) => (
          <li><ProjectCard projeto={projeto} /></li>
        ))}
      </ul>
      <p class="mt-4"><a class="inline-flex min-h-11 items-center font-medium" href="/projetos">Ver todos os projetos</a></p>
    </section>
  )}
  <MetodoIA />
  <ExperienciaResumo itens={experiencia} />
  <Contato />
</BaseLayout>
