---
import type { CollectionEntry } from 'astro:content';
import { ROTULO_CONTEXTO, ROTULO_STATUS } from '../lib/projetos';
import Icone from './Icone.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  numero: number;
  /** Nível do título, para respeitar a hierarquia da página em que a linha aparece. */
  titulo?: 'h2' | 'h3';
}

const { projeto, numero, titulo: Titulo = 'h3' } = Astro.props;
const { data } = projeto;
const destaque = data.metrics[0];
---

<article class="linha group relative grid gap-x-8 gap-y-3 py-8 md:grid-cols-[6.5rem_1fr_auto] md:items-start md:py-10">
  <span class="numero metal" aria-hidden="true">{String(numero).padStart(2, '0')}</span>
  <div class="min-w-0">
    <p class="rotulo">{data.draft && 'Rascunho · '}{ROTULO_CONTEXTO[data.context]} · {ROTULO_STATUS[data.status]}</p>
    <Titulo class="titulo-linha mt-2">
      <!-- O ::after estica o link por toda a linha, sem aninhar outros elementos dentro dele. -->
      <a href={`/projetos/${data.slug}`} class="no-underline after:absolute after:inset-0">
        <span class="nome">{data.title}</span>
      </a>
    </Titulo>
    <p class="mt-3 max-w-2xl text-texto-suave">{data.summary}</p>
    <p class="mt-3 text-sm text-texto-suave">{data.stack.slice(0, 6).join(' · ')}</p>
  </div>
  <div class="flex items-center gap-6 md:flex-col md:items-end">
    {destaque && (
      <p class="text-right">
        <span class="metal block text-4xl font-extrabold tracking-tight">{destaque.value}</span>
        <span class="block text-xs text-texto-suave">{destaque.label}</span>
      </p>
    )}
    <span class="seta ml-auto md:ml-0" aria-hidden="true"><Icone nome="externo" class="size-6" /></span>
  </div>
</article>

<style>
  .numero {
    font-size: clamp(2.5rem, 2rem + 2.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .nome {
    color: var(--texto);
  }

  /* Ao passar o mouse, o título vira metal e a seta avança. */
  .linha:hover .nome {
    -webkit-text-fill-color: transparent;
    background-color: var(--texto);
    background-image: var(--cromo-letras);
    background-position: center;
    background-size: 900px auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .seta {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 999px;
    color: var(--texto);
    background:
      linear-gradient(var(--fundo), var(--fundo)) padding-box,
      var(--cromo-borda) border-box;
    border: 1px solid transparent;
  }

  .linha:hover .seta {
    color: var(--cromo-botao-texto);
    background: var(--cromo-botao);
  }

  /* A régua fica dentro da linha para acompanhar o filtro quando ela é escondida. */
  .linha::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--cromo-regua);
  }

  @media (prefers-reduced-motion: no-preference) {
    .seta {
      transition: translate 200ms ease;
    }

    .linha:hover .seta {
      translate: 4px -4px;
    }
  }
</style>
