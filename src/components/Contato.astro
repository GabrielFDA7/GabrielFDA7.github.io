---
import { site } from '../config/site';
import Icone from './Icone.astro';
---

<section class="pagina mt-secao" aria-labelledby="contato">
  <p class="rotulo">Contato</p>
  <h2 id="contato" class="mt-3 text-3xl font-bold tracking-tight">Vamos conversar</h2>
  <p class="mt-3 text-texto-suave">O caminho mais rápido é o e-mail.</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a class="btn btn-cromo max-w-full whitespace-normal! break-all" href={`mailto:${site.links.email}`}>
      <Icone nome="email" class="size-5 shrink-0" />
      {site.links.email}
    </a>
    <a class="btn btn-contorno" href={site.links.linkedin}>
      <Icone nome="linkedin" />
      LinkedIn
    </a>
    <a class="btn btn-contorno" href={site.links.github}>
      <Icone nome="github" />
      GitHub
    </a>
  </div>
</section>
