---
import type { CollectionEntry } from 'astro:content';

interface Props {
  itens: readonly CollectionEntry<'experiencia'>[];
}

const { itens } = Astro.props;
---

<section class="pagina mt-secao" aria-labelledby="experiencia">
  <p class="rotulo">Trajetória</p>
  <h2 id="experiencia" class="mt-3 text-3xl font-bold tracking-tight">Experiência</h2>
  <ul class="mt-8 flex flex-col">
    {itens.map(({ data }) => (
      <li class="grid gap-x-8 gap-y-1 border-t border-linha py-6 md:grid-cols-[14rem_1fr]">
        <p class="text-sm text-texto-suave">{data.period}</p>
        <div>
          <h3 class="font-semibold tracking-tight">{data.cargo}</h3>
          <p class="text-sm text-texto-suave">{data.empresa}{data.contexto ? ` · ${data.contexto}` : ''}</p>
          <p class="mt-2 max-w-2xl">{data.resumo}</p>
        </div>
      </li>
    ))}
  </ul>
  <p class="mt-2"><a class="inline-flex min-h-11 items-center font-medium" href="/sobre">Trajetória completa</a></p>
</section>
