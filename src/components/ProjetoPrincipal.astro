---
import { idiomaDaPagina, rotaProjeto } from '../i18n';
import type { Projeto } from '../lib/conteudo';
import ArteCromo from './ArteCromo.astro';
import CapaProjeto from './CapaProjeto.astro';
import Icone from './Icone.astro';
import Metricas from './Metricas.astro';

interface Props {
  projeto: Projeto;
}

const { projeto } = Astro.props;
const { data } = projeto;
const { idioma, t } = idiomaDaPagina(Astro.url);
// "NextUp — recomendador..." vira um nome enorme e uma linha de apoio.
const [nome = data.title, ...resto] = data.title.split(' — ');
const apoio = resto.join(' — ');
// Sem captura de celular, entra a tela larga, na moldura de cromo, como no estudo de caso.
const larga = !data.cover && data.coverLargo;
---

<section class="principal relative overflow-clip" aria-labelledby="projeto-principal">
  <div class="arte"><ArteCromo class="size-full" /></div>
  <div class:list={['pagina grade relative py-10 lg:py-20', { 'com-tela-larga': larga }]}>
    <div class="cabeca min-w-0">
      <p class="rotulo com-conta">{t.inicio.projetoPrincipal}</p>
      <h2 id="projeto-principal" class:list={['mt-3 pb-2', apoio ? 'titulo-gigante' : 'titulo-longo']}><span class="metal">{nome}</span></h2>
      {apoio && <p class="mt-2 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">{apoio}</p>}
    </div>

    {data.cover && (
      <div class="aparelho">
        <div class="tela">
          <CapaProjeto
            claro={data.cover}
            escuro={data.coverEscuro}
            alt={data.coverAlt ?? ''}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 19rem, 16rem"
            class="size-full object-cover object-top"
          />
        </div>
      </div>
    )}

    {larga && (
      <figure class="tela-larga">
        <div class="moldura-tela">
          <CapaProjeto
            claro={data.coverLargo!}
            escuro={data.coverLargoEscuro}
            alt={data.coverAlt ?? ''}
            widths={[640, 960, 1440]}
            sizes="(min-width: 64rem) 36rem, 100vw"
            class="w-full rounded-[0.75rem]"
          />
        </div>
        {data.coverLegenda && <figcaption class="mt-3 text-sm text-texto-suave">{data.coverLegenda}</figcaption>}
      </figure>
    )}

    <div class="corpo min-w-0">
      <p class="max-w-xl text-lg text-texto-suave">{data.summary}</p>
      <div class="mt-6 lg:mt-10"><Metricas itens={data.metrics} /></div>
      <div class="botoes mt-6 lg:mt-10">
        <a class="btn btn-cromo" href={rotaProjeto(idioma, data.slug)}>{t.projeto.verEstudo}</a>
        {data.links.demo && (
          <a class="btn btn-contorno" href={data.links.demo}>
            {t.projeto.demo}
            <Icone nome="externo" class="size-4" />
          </a>
        )}
        {data.links.repo && (
          <a class="btn btn-contorno" href={data.links.repo}>
            <Icone nome="github" />
            {t.projeto.codigo}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Celular: nome, aparelho e só depois o texto. O produto aparece junto do nome dele. */
  .grade {
    display: grid;
    gap: 1.75rem;
  }

  .arte {
    display: none;
  }

  /* O celular tem moldura de cromo: a captura vira objeto da composição. */
  .aparelho {
    justify-self: center;
    width: min(100%, 15.5rem);
    padding: 0.5rem;
    border-radius: 2.75rem;
    background: var(--cromo-borda);
    box-shadow:
      0 0 0 1px var(--linha),
      0 2.5rem 5rem -2rem color-mix(in srgb, var(--quente) 45%, transparent);
    rotate: 3deg;
  }

  .tela {
    overflow: hidden;
    aspect-ratio: 390 / 760;
    border-radius: 2.25rem;
    background: var(--fundo);
  }

  /* Computador: texto à esquerda e aparelho à direita, centrados na altura. */
  @media (min-width: 64rem) {
    .grade {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto auto 1fr;
      gap: 0 3rem;
    }

    .cabeca {
      grid-area: 2 / 1;
      max-width: 40rem;
    }

    .corpo {
      grid-area: 3 / 1;
      max-width: 40rem;
      margin-top: 1rem;
    }

    .aparelho {
      grid-area: 1 / 2 / 5 / 3;
      align-self: center;
      width: 19rem;
    }

    /* Tela larga: as duas colunas dividem a largura, e o título longo cabe em poucas linhas. */
    .com-tela-larga {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 0 4rem;
    }

    .tela-larga {
      grid-area: 1 / 2 / 5 / 3;
      align-self: center;
    }

    .com-tela-larga .titulo-longo {
      font-size: clamp(2.25rem, 1rem + 2.6vw, 3.5rem);
      text-wrap: balance;
    }

    /* A arte fica atrás do aparelho, nunca atrás do texto. */
    .arte {
      position: absolute;
      inset: 0 0 0 auto;
      display: block;
      width: 52%;
      --lado: linear-gradient(to right, transparent, rgb(0 0 0 / 0.15) 18%, rgb(0 0 0 / 0.6) 34%, #000 56%);
      --base: linear-gradient(to bottom, transparent, #000 14%, #000 80%, transparent);
      -webkit-mask-image: var(--lado), var(--base);
      mask-image: var(--lado), var(--base);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
      pointer-events: none;
    }
  }
</style>
