---
import { Image } from 'astro:assets';
import foto from '../assets/foto/gabriel.jpg';
import { site } from '../config/site';

interface Props {
  tamanho: number;
  class?: string;
}

const { tamanho, class: classe } = Astro.props;
---

<span class:list={['moldura inline-block shrink-0 rounded-full p-0.5', classe]}>
  <Image
    src={foto}
    alt={`Foto de ${site.nome}`}
    width={tamanho}
    height={tamanho}
    densities={[1, 2, 3]}
    class="block rounded-full"
  />
</span>

<style>
  .moldura {
    background: var(--cromo-borda);
  }
</style>
