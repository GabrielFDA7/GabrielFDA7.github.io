---
import { idiomaDaPagina, rotaProjeto } from '../i18n';
import type { Projeto } from '../lib/conteudo';

interface Props {
  anterior?: Projeto | undefined;
  proximo?: Projeto | undefined;
}

const { anterior, proximo } = Astro.props;
const { idioma, t } = idiomaDaPagina(Astro.url);
const itens = [
  anterior && { rotulo: t.estudo.anterior, projeto: anterior, classe: '' },
  proximo && { rotulo: t.estudo.proximo, projeto: proximo, classe: 'sm:col-start-2 sm:text-right' },
].filter((item) => !!item);
---

{itens.length > 0 && (
  <nav aria-label={t.estudo.outros} class="mt-12 grid gap-8 sm:grid-cols-2">
    {itens.map((item) => (
      <a href={rotaProjeto(idioma, item.projeto.data.slug)} class:list={['block no-underline', item.classe]}>
        <span class="rotulo block">{item.rotulo}</span>
        <span class="metal titulo-navegacao mt-2">{item.projeto.data.title}</span>
      </a>
    ))}
  </nav>
)}
