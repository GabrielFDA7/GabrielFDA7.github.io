---
import { getCollection, render } from 'astro:content';
import FotoPerfil from '../components/FotoPerfil.astro';
import TituloSecao from '../components/TituloSecao.astro';
import TopoPagina from '../components/TopoPagina.astro';
import VitrineTecnologias from '../components/VitrineTecnologias.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const experiencias = (await getCollection('experiencia')).toSorted((a, b) => a.data.order - b.data.order);
const linhaDoTempo = await Promise.all(
  experiencias.map(async (item) => ({ ...item.data, Corpo: (await render(item)).Content })),
);

const alemDoCodigo = [
  'Instrutor de workshops internos de Python (Pandas e Selenium) e tutor do squad de estagiários na Sotreq.',
  'Presidente da CIPA na Sotreq Uberlândia.',
  'Maratona de programação: algoritmos e estruturas de dados (grafos, programação dinâmica, teoria dos números e algoritmos gulosos), em C e C++20.',
  'Freelance: identidades visuais para 4 pequenos negócios, com os kits gerados por código (Python e Pillow).',
];
---

<BaseLayout title="Sobre" description={`Trajetória, experiência, formação e idiomas de ${site.nome}.`} imagem="sobre">
  <TopoPagina titulo="Sobre" rotulo={site.nome}>
    <div class="mt-5 flex max-w-2xl flex-col gap-4 text-lg">
      <p>Entrei na Sotreq, revenda oficial Caterpillar no Brasil, em fevereiro de 2025, como estagiário de Automação e Dados. Em março de 2026 passei a Analista de Leads, e hoje construo pipelines, integrações e automações sobre dados de máquinas e do SAP.</p>
      <p>Fora do trabalho, construí o <a href="/projetos/nextup/">NextUp</a>, uma API em Python em produção, com testes, CI e deploy contínuo.</p>
      <p>Estudo Sistemas de Informação na UFU, com conclusão em dezembro de 2027.</p>
    </div>
    <div slot="lado" class="foto-lado"><FotoPerfil tamanho={220} class="relative p-1" /></div>
  </TopoPagina>

  <section class="pagina mt-4 lg:mt-14" aria-labelledby="linha-do-tempo">
    <TituloSecao id="linha-do-tempo" rotulo="Trajetória" titulo="Experiência" />
    <ol class="tubo mt-8 max-w-3xl lg:mt-10">
      {linhaDoTempo.map(({ cargo, empresa, contexto, period, Corpo }) => (
        <li class="parada">
          <p class="rotulo">{period}</p>
          <h3 class="mt-2 text-2xl font-bold tracking-tight">{cargo}</h3>
          <p class="text-sm text-texto-suave">{empresa}{contexto ? ` · ${contexto}` : ''}</p>
          <div class="prosa mt-4"><Corpo /></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pagina mt-secao" aria-labelledby="tecnologias">
    <TituloSecao id="tecnologias" rotulo="O que uso" titulo="Tecnologias" />
    <VitrineTecnologias />
  </section>

  <section class="pagina mt-secao" aria-labelledby="alem">
    <TituloSecao id="alem" rotulo="Fora do dia a dia" titulo="Além do código" />
    <div class="prosa mt-8 max-w-3xl">
      <ul>
        {alemDoCodigo.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="pagina mt-secao grid gap-10 sm:grid-cols-2" aria-label="Formação e idiomas">
    <div>
      <p class="rotulo com-conta">Formação</p>
      <p class="metal numero-gigante mt-3">2027</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">Bacharelado em Sistemas de Informação</h2>
      <p class="mt-1 text-texto-suave">Universidade Federal de Uberlândia · 6º período · conclusão em dez/2027</p>
      <p class="mt-1 text-texto-suave">VIII Iniciação Científica da FAMAT/UFU</p>
    </div>
    <div>
      <!-- Ao lado da Formação, esta coluna não encosta no fio: a esfera só existe quando empilha. -->
      <p class="rotulo com-conta sm:before:hidden">Idiomas</p>
      <p class="metal numero-gigante mt-3">C1</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">Inglês</h2>
      <p class="mt-1 text-texto-suave">FCE, Cambridge</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Celular: a foto vem antes do texto, pequena, no lugar em que a abertura também a mostra. */
  .foto-lado {
    order: -1;
    align-self: flex-start;
    width: 6.5rem;
    margin-bottom: -0.75rem;
  }

  .foto-lado :global(span) {
    display: block;
  }

  @media (min-width: 64rem) {
    .foto-lado {
      order: 0;
      align-self: auto;
      width: auto;
      margin-bottom: 0;
    }

    .foto-lado :global(span) {
      display: inline-block;
    }
  }
</style>
