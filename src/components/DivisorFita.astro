---
// Linha fina de cromo entre as seções. É decorativa: o leitor de tela não precisa dela.
import { Image } from 'astro:assets';
import fitaA from '../assets/arte/fita-a.webp';
import fitaB from '../assets/arte/fita-b.webp';

interface Props {
  variante?: 'a' | 'b';
  espelhada?: boolean;
  class?: string;
}

const { variante = 'a', espelhada = false, class: classe } = Astro.props;
---

<div class:list={['fita', espelhada && 'fita-espelhada', classe]} aria-hidden="true">
  <Image
    src={variante === 'a' ? fitaA : fitaB}
    alt=""
    widths={[900, 1400, 1800]}
    sizes="max(100vw, 44rem)"
    loading="lazy"
  />
</div>

<style>
  /* No celular a linha é mais larga que a tela: as pontas somem e o traço não fica fino demais. */
  .fita {
    display: flex;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }

  .fita img {
    width: max(100%, 44rem);
    max-width: none;
    height: auto;
    filter: var(--sombra-emblema);
  }

  .fita-espelhada img {
    scale: -1 1;
  }

  /* A linha desliza um pouco durante a rolagem, sem JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .fita img {
        animation: deslizar linear both;
        animation-timeline: view();
      }

      @keyframes deslizar {
        from {
          translate: -3% 0;
        }

        to {
          translate: 3% 0;
        }
      }
    }
  }
</style>
