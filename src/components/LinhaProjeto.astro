---
import type { CollectionEntry } from 'astro:content';
import { ROTULO_CONTEXTO, ROTULO_STATUS } from '../lib/projetos';
import Icone from './Icone.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  numero: number;
  /** Nível do título, para respeitar a hierarquia da página em que a linha aparece. */
  titulo?: 'h2' | 'h3';
}

const { projeto, numero, titulo: Titulo = 'h3' } = Astro.props;
const { data } = projeto;
const destaque = data.metrics[0];
---

<article class="linha group relative">
  <span class="numero metal" aria-hidden="true">{String(numero).padStart(2, '0')}</span>
  <div class="cabeca min-w-0">
    <p class="rotulo">{data.draft && 'Rascunho · '}{ROTULO_CONTEXTO[data.context]} · {ROTULO_STATUS[data.status]}</p>
    <Titulo class="titulo-linha mt-2">
      <!-- O ::after estica o link por toda a linha, sem aninhar outros elementos dentro dele. -->
      <a href={`/projetos/${data.slug}/`} class="no-underline after:absolute after:inset-0">
        <span class="nome">{data.title}</span>
      </a>
    </Titulo>
  </div>
  <div class="corpo min-w-0">
    <p class="max-w-2xl text-texto-suave">{data.summary}</p>
    <p class="mt-3 text-sm text-texto-suave">{data.stack.slice(0, 6).join(' · ')}</p>
  </div>
  {destaque && (
    <p class="dados">
      <span class="metal valor">{destaque.value}</span>
      <span class="text-xs text-texto-suave">{destaque.label}</span>
    </p>
  )}
  <span class="seta" aria-hidden="true"><Icone nome="externo" class="size-5 md:size-6" /></span>
</article>

<style>
  /* Celular: número, título e seta na mesma linha, com o resto abaixo em toda a largura. */
  .linha {
    display: grid;
    grid-template-areas:
      'numero cabeca seta'
      'corpo corpo corpo'
      'dados dados dados';
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem 0.875rem;
    padding-block: 1.5rem;
  }

  .numero {
    grid-area: numero;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .cabeca {
    grid-area: cabeca;
  }

  .corpo {
    grid-area: corpo;
  }

  .seta {
    grid-area: seta;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 999px;
    color: var(--texto);
    background:
      linear-gradient(var(--fundo), var(--fundo)) padding-box,
      var(--cromo-borda) border-box;
    border: 1px solid transparent;
  }

  .dados {
    grid-area: dados;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .valor {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  /* Computador: três colunas, com o número em destaque à esquerda. */
  @media (min-width: 48rem) {
    .linha {
      grid-template-areas:
        'numero cabeca dados'
        'numero corpo seta';
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      gap: 0.75rem 2rem;
      align-items: start;
      padding-block: 2.5rem;
    }

    .numero {
      font-size: clamp(2.5rem, 2rem + 2.5vw, 4rem);
    }

    .seta {
      justify-self: end;
      width: 3rem;
      height: 3rem;
    }

    .dados {
      flex-direction: column;
      align-items: flex-end;
      gap: 0;
      text-align: right;
    }

    .valor {
      font-size: 2.25rem;
    }
  }

  .nome {
    color: var(--texto);
  }

  /* Ao passar o mouse, o título vira metal e a seta avança. */
  .linha:hover .nome {
    -webkit-text-fill-color: transparent;
    background-color: var(--texto);
    background-image: var(--cromo-letras);
    background-position: center;
    background-size: 900px auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .linha:hover .seta {
    color: var(--cromo-botao-texto);
    background: var(--cromo-botao);
  }

  /* A régua fica dentro da linha para acompanhar o filtro quando ela é escondida. */
  .linha::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--cromo-regua);
  }

  @media (prefers-reduced-motion: no-preference) {
    .seta {
      transition: translate 200ms ease;
    }

    .linha:hover .seta {
      translate: 4px -4px;
    }
  }
</style>
