---
/*
 * Estudo de caso. A abertura responde a quem lê com pressa: o problema, o que eu fiz e o resultado,
 * em uma frase cada (campo `resumo`). A ficha e o índice ficam numa coluna lateral no computador.
 * Projeto com imagem a mostra no lugar da arte de cromo, na moldura de cromo.
 */
import type { MarkdownHeading } from 'astro';
import CapaProjeto from '../components/CapaProjeto.astro';
import Icone from '../components/Icone.astro';
import NavProjetos from '../components/NavProjetos.astro';
import StackChips from '../components/StackChips.astro';
import TopoPagina from '../components/TopoPagina.astro';
import { idiomaDaPagina, outroIdioma, rota, rotaProjeto } from '../i18n';
import type { Projeto } from '../lib/conteudo';
import BaseLayout from './BaseLayout.astro';

interface Props {
  projeto: Projeto;
  headings: MarkdownHeading[];
  anterior?: Projeto | undefined;
  proximo?: Projeto | undefined;
}

const { projeto, headings, anterior, proximo } = Astro.props;
const { data } = projeto;
const { idioma, t } = idiomaDaPagina(Astro.url);
const outro = outroIdioma(idioma);
const slugOutro = projeto.slugs[outro];
const alternativa = slugOutro ? rotaProjeto(outro, slugOutro) : undefined;
// "NextUp — recomendador..." vira um nome grande e uma linha de apoio, como na home.
const [nome = data.title, ...resto] = data.title.split(' — ');
const apoio = resto.join(' — ');
// "Time de 3 — responsável por...": o que vem antes do travessão é a equipe; o resto já está no resumo.
const equipe = data.role.split(' — ')[0];
const secoes = headings.filter((h) => h.depth === 2);
const resumo = [
  { termo: t.estudo.problema, texto: data.resumo.problema },
  { termo: t.estudo.feito, texto: data.resumo.feito },
  { termo: t.estudo.resultado, texto: data.resumo.resultado },
];
// A tela larga tem preferência; a capa quadrada ou de celular entra quando é a única.
const imagem = data.coverLargo
  ? { claro: data.coverLargo, escuro: data.coverLargoEscuro, larga: true }
  : data.cover
    ? { claro: data.cover, escuro: data.coverEscuro, larga: false }
    : undefined;
---

<BaseLayout title={data.title} description={data.summary} imagem={projeto.slugs.pt} arteNoComputador={!imagem} alternativa={alternativa}>
  <article>
    <TopoPagina titulo={nome} apoio={apoio || undefined} rotulo={t.projeto.contexto[data.context]} descricao={data.summary} longo={!apoio} semArte={!!imagem}>
      <p slot="antes" class="mb-4">
        <a class="inline-flex min-h-11 items-center text-sm font-medium" href={rota(idioma, 'projetos')}>{t.estudo.todos}</a>
      </p>
      {imagem && (
        <figure slot="lado" class:list={['imagem-topo', { larga: imagem.larga }]}>
          <div class="moldura-tela">
            <CapaProjeto
              claro={imagem.claro}
              escuro={imagem.escuro}
              alt={data.coverAlt ?? ''}
              widths={imagem.larga ? [640, 960, 1440] : [320, 480, 640]}
              sizes={imagem.larga ? '(min-width: 64rem) 36rem, 100vw' : '(min-width: 64rem) 26rem, 100vw'}
              prioridade
              class="w-full rounded-[0.75rem]"
            />
          </div>
          {data.coverLegenda && <figcaption class="mt-3 text-sm text-texto-suave">{data.coverLegenda}</figcaption>}
        </figure>
      )}
    </TopoPagina>

    <div class="pagina">
      <ol class="resumo" aria-label={t.estudo.emResumo}>
        {resumo.map((item) => (
          <li class="parada">
            <p class="rotulo">{item.termo}</p>
            <p class="mt-2 text-lg leading-snug font-medium lg:text-xl">{item.texto}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="pagina corpo">
      <aside class="lateral" aria-label={t.estudo.sobreProjeto}>
        <dl class="ficha">
          <div>
            <dt class="rotulo">{t.estudo.equipe}</dt>
            <dd>{equipe}</dd>
          </div>
          <div>
            <dt class="rotulo">{t.estudo.periodo}</dt>
            <dd>{data.period}</dd>
          </div>
          <div>
            <dt class="rotulo">{t.estudo.status}</dt>
            <dd>{t.projeto.status[data.status]}</dd>
          </div>
          <div class="toda-linha">
            <dt class="rotulo">{t.estudo.tecnologias}</dt>
            <dd class="mt-2"><StackChips itens={data.stack} /></dd>
          </div>
        </dl>

        {data.confidential && (
          <p class="mt-6 flex items-start gap-3 text-sm text-texto-suave">
            <span class="esfera mt-0.5 shrink-0" aria-hidden="true"></span>
            {data.avisoConfidencial ?? t.estudo.avisoPadrao}
          </p>
        )}

        {(data.links.repo || data.links.demo) && (
          <div class="links">
            {data.links.demo && (
              <a class="btn btn-cromo" href={data.links.demo}>
                {t.projeto.demo}
                <Icone nome="externo" class="size-4" />
              </a>
            )}
            {data.links.repo && (
              <a class="btn btn-contorno" href={data.links.repo}>
                <Icone nome="github" />
                {t.projeto.codigo}
              </a>
            )}
          </div>
        )}

        {secoes.length > 1 && (
          <nav class="indice" aria-label={t.estudo.nestaPagina}>
            <p class="rotulo">{t.estudo.nestaPagina}</p>
            <ol class="mt-1 text-sm">
              {secoes.map((secao) => (
                <li><a class="text-texto-suave no-underline hover:text-destaque" href={`#${secao.slug}`}>{secao.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <div class="prosa estudo min-w-0">
        <slot />
        <NavProjetos anterior={anterior} proximo={proximo} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* A imagem do projeto no lugar da arte: no celular, logo abaixo do resumo do título. */
  .imagem-topo {
    width: 100%;
  }

  .imagem-topo:not(.larga) {
    max-width: 22rem;
  }

  @media (min-width: 64rem) {
    .imagem-topo {
      flex: 0 0 auto;
      width: 36%;
      max-width: 26rem;
    }

    .imagem-topo.larga {
      width: 46%;
      max-width: 36rem;
    }
  }

  /* Três frases que respondem, sem rolar, o que um recrutador quer saber. */
  .resumo {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    list-style: none;
    padding-top: 0.5rem;
  }

  @media (min-width: 64rem) {
    .resumo {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
      padding-top: 1rem;
    }
  }

  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 1.25rem 2rem;
  }

  .ficha dd:not(.mt-2) {
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .toda-linha {
    grid-column: 1 / -1;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .indice {
    display: none;
  }

  .corpo {
    margin-top: 3rem;
  }

  .estudo {
    margin-top: 1rem;
  }

  /* Computador: ficha e índice numa coluna que acompanha a leitura. */
  @media (min-width: 64rem) {
    .corpo {
      display: grid;
      grid-template-columns: 15rem minmax(0, 46rem);
      gap: 5rem;
      justify-content: center;
      margin-top: 4rem;
    }

    /*
     * Só o índice acompanha a leitura. A coluna inteira fixa passava da altura da tela em notebook
     * (1366x768) quando o projeto tinha muitas tecnologias, e o índice ficava inalcançável.
     */
    .lateral {
      align-self: stretch;
    }

    .ficha,
    .links {
      grid-template-columns: 1fr;
    }

    .indice {
      position: sticky;
      top: 6rem;
      display: block;
      margin-top: 2.5rem;
    }

    /* Área de clique de 33 px por item: o texto é pequeno, o alvo não precisa ser. */
    .indice a {
      display: block;
      padding-block: 0.5rem;
    }

    .estudo {
      margin-top: -4.5rem; /* o primeiro h2 tem margem própria; alinha o topo com a ficha */
    }
  }

  .estudo :global(h2) {
    scroll-margin-top: 6rem;
  }

  /*
   * "**Decisão.** Explicação": a decisão vira um subtítulo e a explicação fica embaixo. Só a partir
   * de "Decisões técnicas": antes dela, o negrito é um rótulo com dois-pontos ("O que foi meu:").
   */
  .estudo :global(h2:is([id='decisões-técnicas'], [id='technical-decisions']) ~ p > strong:first-child) {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }

  .estudo :global(h2:is([id='decisões-técnicas'], [id='technical-decisions']) ~ p:has(> strong:first-child)) {
    margin-top: 1.75rem;
  }
</style>
