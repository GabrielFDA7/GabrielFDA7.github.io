---
// A arte é decorativa, então entra como fundo CSS: assim o navegador baixa só a
// imagem do tema ativo, no tamanho certo, o que duas <img> escondidas não garantem.
import { enderecosDaArte } from '../lib/arte';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
const { claroP, claroG, escuroP, escuroG } = await enderecosDaArte();

const variaveis = [
  `--claro-p:url(${claroP})`,
  `--claro-g:url(${claroG})`,
  `--escuro-p:url(${escuroP})`,
  `--escuro-g:url(${escuroG})`,
].join(';');
---

<div class:list={['arte-cromo', classe]} style={variaveis} aria-hidden="true"></div>

<style>
  .arte-cromo {
    --pequena: var(--claro-p);
    --grande: var(--claro-g);
    background-image: var(--pequena);
    background-position: center;
    background-size: cover;
  }

  @media (min-width: 48rem) {
    .arte-cromo {
      background-image: var(--grande);
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arte-cromo {
      --pequena: var(--escuro-p);
      --grande: var(--escuro-g);
    }
  }

  :global(:root[data-theme='dark']) .arte-cromo {
    --pequena: var(--escuro-p);
    --grande: var(--escuro-g);
  }

  @media (forced-colors: active) {
    .arte-cromo {
      display: none;
    }
  }
</style>
