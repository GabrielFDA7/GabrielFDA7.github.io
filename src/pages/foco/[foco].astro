---
// Links enviados em cada candidatura: fora do menu e sem indexação, para não competir com a home.
import Inicio from '../../components/Inicio.astro';
import { FOCOS, type Foco } from '../../config/focos';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return Object.entries(FOCOS).map(([foco, config]) => ({ params: { foco }, props: { config } }));
}

interface Props {
  config: Foco;
}

const { config } = Astro.props;
---

<BaseLayout title={config.chamada} description={config.chamada} noindex>
  <Inicio foco={config} />
</BaseLayout>
