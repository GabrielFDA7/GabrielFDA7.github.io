---
import { getCollection, render } from 'astro:content';
import EstudoDeCaso from '../../layouts/EstudoDeCaso.astro';
import { publicados, vizinhos } from '../../lib/projetos';

export async function getStaticPaths() {
  const lista = publicados(await getCollection('projetos'));
  return lista.map((projeto, indice) => ({
    params: { slug: projeto.data.slug },
    props: { projeto, ...vizinhos(lista, indice) },
  }));
}

const { projeto, anterior, proximo } = Astro.props;
const { Content } = await render(projeto);
---

<EstudoDeCaso projeto={projeto} anterior={anterior} proximo={proximo}>
  <Content />
</EstudoDeCaso>
