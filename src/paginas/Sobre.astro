---
import { render } from 'astro:content';
import FotoPerfil from '../components/FotoPerfil.astro';
import TituloSecao from '../components/TituloSecao.astro';
import TopoPagina from '../components/TopoPagina.astro';
import VitrineTecnologias from '../components/VitrineTecnologias.astro';
import { site } from '../config/site';
import { idiomaDaPagina, outroIdioma, rota } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { experienciaNoIdioma } from '../lib/conteudo';

const { idioma, t } = idiomaDaPagina(Astro.url);
const linhaDoTempo = await Promise.all(
  (await experienciaNoIdioma(idioma)).map(async (item) => ({ ...item.data, Corpo: (await render(item.entrada)).Content })),
);
---

<BaseLayout title={t.sobre.titulo} description={t.sobre.descricao} imagem="sobre" alternativa={rota(outroIdioma(idioma), 'sobre')}>
  <TopoPagina titulo={t.sobre.titulo} rotulo={site.nome}>
    <div class="mt-5 flex max-w-2xl flex-col gap-4 text-lg">
      {t.sobre.paragrafos.map((paragrafo) => <p set:html={paragrafo} />)}
    </div>
    <div slot="lado" class="foto-lado"><FotoPerfil tamanho={220} class="relative p-1" /></div>
  </TopoPagina>

  <section class="pagina mt-4 lg:mt-14" aria-labelledby="linha-do-tempo">
    <TituloSecao id="linha-do-tempo" rotulo={t.experiencia.rotulo} titulo={t.experiencia.titulo} />
    <ol class="tubo mt-8 max-w-3xl lg:mt-10">
      {linhaDoTempo.map(({ cargo, empresa, contexto, period, Corpo }) => (
        <li class="parada">
          <p class="rotulo">{period}</p>
          <h3 class="mt-2 text-2xl font-bold tracking-tight">{cargo}</h3>
          <p class="text-sm text-texto-suave">{empresa}{contexto ? ` · ${contexto}` : ''}</p>
          <div class="prosa mt-4"><Corpo /></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="pagina mt-secao" aria-labelledby="tecnologias">
    <TituloSecao id="tecnologias" rotulo={t.sobre.tecnologiasRotulo} titulo={t.sobre.tecnologias} />
    <VitrineTecnologias />
  </section>

  <section class="pagina mt-secao" aria-labelledby="alem">
    <TituloSecao id="alem" rotulo={t.sobre.alemRotulo} titulo={t.sobre.alem} />
    <div class="prosa mt-8 max-w-3xl">
      <ul>
        {t.sobre.alemItens.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="pagina mt-secao grid gap-10 sm:grid-cols-2" aria-label={t.sobre.formacaoEIdiomas}>
    <div>
      <p class="rotulo com-conta">{t.sobre.formacao}</p>
      <p class="metal numero-gigante mt-3">2027</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">{t.sobre.curso}</h2>
      <p class="mt-1 text-texto-suave">{t.sobre.faculdade}</p>
      <p class="mt-1 text-texto-suave">{t.sobre.pesquisa}</p>
    </div>
    <div>
      <!-- Ao lado da Formação, esta coluna não encosta no fio: a esfera só existe quando empilha. -->
      <p class="rotulo com-conta sm:before:hidden">{t.sobre.idiomas}</p>
      <p class="metal numero-gigante mt-3">C1</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight">{t.sobre.ingles}</h2>
      <p class="mt-1 text-texto-suave">FCE, Cambridge</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Celular: a foto vem antes do texto, pequena, no lugar em que a abertura também a mostra. */
  .foto-lado {
    order: -1;
    align-self: flex-start;
    width: 6.5rem;
    margin-bottom: -0.75rem;
  }

  .foto-lado :global(span) {
    display: block;
  }

  @media (min-width: 64rem) {
    .foto-lado {
      order: 0;
      align-self: auto;
      width: auto;
      margin-bottom: 0;
    }

    .foto-lado :global(span) {
      display: inline-block;
    }
  }
</style>
