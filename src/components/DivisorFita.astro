---
// Linha fina de cromo entre as seções. É decorativa: o leitor de tela não precisa dela.
import { Image } from 'astro:assets';
import fitaA from '../assets/arte/fita-a.webp';
import fitaB from '../assets/arte/fita-b.webp';

interface Props {
  variante?: 'a' | 'b';
  class?: string;
}

const { variante = 'a', class: classe } = Astro.props;
---

<div class:list={['fita', classe]} aria-hidden="true">
  <Image
    src={variante === 'a' ? fitaA : fitaB}
    alt=""
    widths={[900, 1400, 1800]}
    sizes="100vw"
    loading="lazy"
  />
</div>

<style>
  /* No celular, quem separa as seções é o fio condutor. Oculta, a imagem nem é baixada. */
  .fita {
    display: none;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .fita {
      display: flex;
    }
  }

  .fita img {
    width: 100%;
    max-width: none;
    height: auto;
    filter: var(--sombra-emblema);
  }

  /* A linha desliza um pouco durante a rolagem, sem JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .fita img {
        animation: deslizar linear both;
        animation-timeline: view();
      }

      @keyframes deslizar {
        from {
          translate: -3% 0;
        }

        to {
          translate: 3% 0;
        }
      }
    }
  }
</style>
