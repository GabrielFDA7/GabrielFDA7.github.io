---
import { Image } from 'astro:assets';
import emblema from '../assets/arte/emblema-grande.webp';
import ArteCromo from '../components/ArteCromo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="Esta página não existe. Veja os links para continuar navegando.">
  <section class="erro relative overflow-hidden">
    <div class="arte"><ArteCromo class="size-full" /></div>
    <div class="pagina relative py-12 lg:py-24">
      <p class="metal quatro" aria-hidden="true">404</p>
      <h1 class="titulo-longo mt-2 pb-2"><span class="metal">Página não encontrada</span></h1>
      <p class="mt-4 max-w-xl text-lg text-texto-suave">O endereço pode estar errado, ou a página mudou de lugar. Daqui você consegue seguir:</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-cromo" href="/">Página inicial</a>
        <a class="btn btn-contorno" href="/projetos">Projetos</a>
        <a class="btn btn-contorno" href="/sobre">Sobre</a>
      </div>
      <Image src={emblema} alt="" widths={[320, 640]} sizes="16rem" class="emblema mt-12 w-40 lg:absolute lg:right-16 lg:bottom-16 lg:mt-0 lg:w-64" />
    </div>
  </section>
</BaseLayout>

<style>
  .arte {
    height: 7rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000 35%, transparent);
  }

  .quatro {
    display: block;
    width: fit-content;
    font-size: clamp(7rem, 5rem + 12vw, 15rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .emblema {
    filter: var(--sombra-emblema);
  }

  @media (min-width: 64rem) {
    .arte {
      position: absolute;
      inset-block: 0;
      right: 0;
      width: 50%;
      height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent, rgb(0 0 0 / 0.15) 20%, #000 60%);
      mask-image: linear-gradient(to right, transparent, rgb(0 0 0 / 0.15) 20%, #000 60%);
    }
  }
</style>
