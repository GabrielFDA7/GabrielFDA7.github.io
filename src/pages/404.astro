---
import FaixaCromo from '../components/FaixaCromo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="Esta página não existe. Veja os links para continuar navegando.">
  <FaixaCromo />
  <div class="pagina mt-8 max-w-3xl!">
    <p class="rotulo">Erro 404</p>
    <h1 class="mt-3 pb-1 text-5xl font-bold tracking-tight"><span class="cromo-texto">Página não encontrada</span></h1>
    <p class="mt-4 text-lg text-texto-suave">O endereço pode estar errado, ou a página mudou de lugar. Daqui você consegue seguir:</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-cromo" href="/">Página inicial</a>
      <a class="btn btn-contorno" href="/projetos">Projetos</a>
      <a class="btn btn-contorno" href="/sobre">Sobre</a>
    </div>
  </div>
</BaseLayout>
