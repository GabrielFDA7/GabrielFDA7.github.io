---
import type { CollectionEntry } from 'astro:content';
import CapaProjeto from '../components/CapaProjeto.astro';
import DivisorFita from '../components/DivisorFita.astro';
import Icone from '../components/Icone.astro';
import Metricas from '../components/Metricas.astro';
import NavProjetos from '../components/NavProjetos.astro';
import StackChips from '../components/StackChips.astro';
import TopoPagina from '../components/TopoPagina.astro';
import { ROTULO_CONTEXTO, ROTULO_STATUS } from '../lib/projetos';
import BaseLayout from './BaseLayout.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  anterior?: CollectionEntry<'projetos'>;
  proximo?: CollectionEntry<'projetos'>;
}

const { projeto, anterior, proximo } = Astro.props;
const { data } = projeto;
const ficha = [
  { termo: 'Status', valor: ROTULO_STATUS[data.status] },
  { termo: 'Período', valor: data.period },
  { termo: 'Meu papel', valor: data.role },
];
// "NextUp — recomendador..." vira um nome grande e uma linha de apoio, como na home.
const [nome = data.title, ...resto] = data.title.split(' — ');
const apoio = resto.join(' — ');
---

<BaseLayout title={data.title} description={data.summary}>
  <article>
    <TopoPagina titulo={nome} apoio={apoio || undefined} rotulo={ROTULO_CONTEXTO[data.context]} descricao={data.summary} longo={!apoio}>
      <p slot="antes" class="mb-4">
        <a class="inline-flex min-h-11 items-center text-sm font-medium" href="/projetos">Todos os projetos</a>
      </p>
      {(data.links.repo || data.links.demo) && (
        <div class="botoes mt-8">
          {data.links.demo && (
            <a class="btn btn-cromo" href={data.links.demo}>
              Abrir demo
              <Icone nome="externo" class="size-4" />
            </a>
          )}
          {data.links.repo && (
            <a class="btn btn-contorno" href={data.links.repo}>
              <Icone nome="github" />
              Código
            </a>
          )}
        </div>
      )}
    </TopoPagina>

    <div class="pagina">
      <div class="pb-4 lg:pt-10"><Metricas itens={data.metrics} /></div>

      <dl class="mt-4 flex max-w-4xl flex-wrap gap-x-8 gap-y-4 sm:mt-6 sm:gap-x-12">
        {ficha.map((item) => (
          <div>
            <dt class="rotulo">{item.termo}</dt>
            <dd class="mt-1 font-medium">{item.valor}</dd>
          </div>
        ))}
      </dl>

      {data.confidential && (
        <p class="mt-6 flex items-center gap-3 text-sm text-texto-suave">
          <span class="esfera shrink-0" aria-hidden="true"></span>
          Projeto corporativo: dados e nomes de clientes omitidos.
        </p>
      )}

      <div class="mt-6"><StackChips itens={data.stack} /></div>
    </div>

    <DivisorFita variante="a" class="mt-6" />

    <div class="pagina">
      {data.coverLargo && (
        <figure class="moldura-tela mx-auto mt-8 max-w-5xl lg:mt-4">
          <CapaProjeto
            claro={data.coverLargo}
            escuro={data.coverLargoEscuro}
            alt={data.coverAlt ?? ''}
            widths={[640, 960, 1440]}
            sizes="(min-width: 64rem) 64rem, 100vw"
            class="w-full rounded-[0.75rem]"
          />
        </figure>
      )}

      <div class="prosa mx-auto mt-12 max-w-3xl">
        {!data.coverLargo && data.cover && (
          <CapaProjeto
            claro={data.cover}
            escuro={data.coverEscuro}
            alt={data.coverAlt ?? ''}
            widths={[320, 480, 640]}
            sizes="(min-width: 40rem) 22rem, 100vw"
            class="capa"
          />
        )}
        <slot />
      </div>

      <div class="mx-auto max-w-3xl">
        <NavProjetos anterior={anterior} proximo={proximo} />
      </div>
    </div>
  </article>
</BaseLayout>
