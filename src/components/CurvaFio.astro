---
// No computador, a arte fica à direita e o fio na margem esquerda. Esta curva liga os dois:
// sai da arte da abertura até o fio e, no rodapé, leva o fio de volta para a direita.
// O desenho não escala: é mais largo que a tela e a caixa corta o excesso.
interface Props {
  sentido: 'sai-da-arte' | 'volta';
}

const { sentido } = Astro.props;
const d = sentido === 'sai-da-arte' ? 'M4000 2 H34 Q2 2 2 34 V48' : 'M2 0 V14 Q2 46 34 46 H4000';
---

<div class:list={['curva', sentido]} aria-hidden="true">
  <svg width="4000" height="48" viewBox="0 0 4000 48" fill="none">
    <path class="traco traco-borda" d={d} />
    <path class="traco traco-meio" d={d} />
    <path class="traco traco-brilho" d={d} />
  </svg>
</div>

<style>
  .curva {
    display: none;
  }

  @media (min-width: 64rem) {
    .curva {
      position: absolute;
      z-index: 1;
      display: block;
      left: var(--x-fio);
      right: 0;
      height: 48px;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, #000 62%, transparent 96%);
      mask-image: linear-gradient(to right, #000 62%, transparent 96%);
      pointer-events: none;
    }

    .sai-da-arte {
      bottom: 0;
    }

    .volta {
      top: 0;
    }

    svg {
      max-width: none;
    }
  }
</style>
