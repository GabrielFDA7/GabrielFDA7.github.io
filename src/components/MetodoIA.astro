---
import FerramentasIA from './FerramentasIA.astro';
import TituloSecao from './TituloSecao.astro';

const BASE = 'https://github.com/GabrielFDA7/nextup';

const praticas = [
  {
    titulo: 'Contexto versionado',
    texto: 'O agente começa cada sessão lendo a arquitetura, as convenções e as decisões em um arquivo que evolui com o código.',
    links: [{ rotulo: 'CLAUDE.md', href: `${BASE}/blob/main/CLAUDE.md` }],
  },
  {
    titulo: 'Skills próprias',
    texto: 'Fluxos repetidos viram instrução executável: uma exige medição antes de escolher um algoritmo ou limiar, e outra fecha a sessão com o registro feito.',
    links: [
      { rotulo: 'medir-antes-de-implementar', href: `${BASE}/blob/main/.claude/skills/medir-antes-de-implementar/SKILL.md` },
      { rotulo: 'fechar-sessao', href: `${BASE}/blob/main/.claude/skills/fechar-sessao/SKILL.md` },
    ],
  },
  {
    titulo: 'Log público de prompts',
    texto: 'Cada prompt fica registrado com o contexto e o que resultou: até agora, 10 sessões e 70 prompts que qualquer pessoa pode auditar.',
    links: [{ rotulo: 'docs/PROMPTS.md', href: `${BASE}/blob/main/docs/PROMPTS.md` }],
  },
  {
    titulo: 'Testes e CI como rede de segurança',
    texto: 'O código do agente passa pelo mesmo crivo que o meu: 946 testes e CI em Python 3.11, 3.12 e 3.13.',
    links: [{ rotulo: 'ci.yml', href: `${BASE}/blob/main/.github/workflows/ci.yml` }],
  },
];
---

<section class="metodo pagina mt-secao" aria-labelledby="metodo-ia">
  <div class="cabeca">
    <TituloSecao
      id="metodo-ia"
      rotulo="Método"
      titulo="Como eu trabalho com IA"
      descricao="O NextUp foi construído com Claude Code. O processo é tão público quanto o código, e cada passo aponta para o arquivo real no repositório."
    />
  </div>

  <div class="ferramentas"><FerramentasIA /></div>

  <ol class="tubo passos">
    {praticas.map((pratica) => (
      <li class="parada">
        <h3 class="text-xl font-bold tracking-tight lg:text-2xl">{pratica.titulo}</h3>
        <p class="mt-2 text-texto-suave">{pratica.texto}</p>
        <ul class="flex flex-wrap gap-x-4">
          {pratica.links.map((link) => (
            <li>
              <a class="inline-flex min-h-11 items-center font-medium break-all" href={link.href}>{link.rotulo}</a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>

<style>
  .ferramentas {
    margin-top: 1.75rem;
  }

  .passos {
    margin-top: 2.25rem;
  }

  /* Computador: os passos ficam na coluna do fio, e os logos acompanham a leitura ao lado. */
  @media (min-width: 64rem) {
    .metodo {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 5rem;
    }

    .cabeca {
      grid-area: 1 / 1;
    }

    .passos {
      grid-area: 2 / 1;
      margin-top: 3rem;
    }

    .ferramentas {
      position: sticky;
      top: 4rem;
      grid-area: 1 / 2 / 3 / 3;
      align-self: start;
      margin-top: 2.25rem;
    }
  }
</style>
