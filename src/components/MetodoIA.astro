---
import FerramentasIA from './FerramentasIA.astro';
import TituloSecao from './TituloSecao.astro';

import { idiomaDaPagina } from '../i18n';

const { t } = idiomaDaPagina(Astro.url);
const praticas = t.metodo.praticas;
---

<section class="pagina mt-secao grid gap-x-16 gap-y-9 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-y-12" aria-labelledby="metodo-ia">
  <div class="fixo">
    <TituloSecao
      id="metodo-ia"
      rotulo={t.metodo.rotulo}
      titulo={t.metodo.titulo}
      descricao={t.metodo.descricao}
    />
    <div class="mt-7 lg:mt-10"><FerramentasIA /></div>
  </div>

  <ol class="tubo">
    {praticas.map((pratica) => (
      <li class="parada">
        <h3 class="text-xl font-bold tracking-tight lg:text-2xl">{pratica.titulo}</h3>
        <p class="mt-2 text-texto-suave">{pratica.texto}</p>
        <ul class="flex flex-wrap gap-x-4">
          {pratica.links.map((link) => (
            <li>
              <a class="inline-flex min-h-11 items-center font-medium break-all" href={link.href}>{link.rotulo}</a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>

<style>
  @media (min-width: 64rem) {
    .fixo {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
</style>
